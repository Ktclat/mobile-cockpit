<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="cockpit-provider-vault-v1.xml" />
        <exclude domain="database" path="cockpit-local.db" />
        <exclude domain="database" path="cockpit-local.db-shm" />
        <exclude domain="database" path="cockpit-local.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cockpit-provider-vault-v1.xml" />
        <exclude domain="database" path="cockpit-local.db" />
        <exclude domain="database" path="cockpit-local.db-shm" />
        <exclude domain="database" path="cockpit-local.db-wal" />
    </device-transfer>
</data-extraction-rules>
