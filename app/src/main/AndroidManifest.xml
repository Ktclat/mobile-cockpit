<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <permission
        android:name="dev.cockpit.mobile.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <uses-permission
        android:name="dev.cockpit.mobile.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <application
        android:name=".CockpitApplication"
        android:label="Cockpit"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <uses-library
            android:name="androidx.window.extensions"
            tools:node="remove" />

        <uses-library
            android:name="androidx.window.sidecar"
            tools:node="remove" />

        <!-- Intentionally removes a transitive manifest component; lint sees this selector, but it is not packaged. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            tools:node="remove"
            tools:ignore="MissingClass" />

        <!-- Intentionally removes a transitive manifest component; lint sees this selector, but it is not packaged. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove"
            tools:ignore="MissingClass" />
    </application>
</manifest>
